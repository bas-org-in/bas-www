# Blogs gateway of bas.org.in.
#
# /blogs and the other files in this folder are static pages. Articles
# are WordPress posts in the Articles category, with the address
# /blogs/<post name>/. A request for a path that is not a file or a
# folder here loads WordPress through the gallery gateway
# (/gallery/index.php). WordPress then shows the article, redirects to the
# address of the post, or shows its 404 page.
#
# The hardening rules are those of the gallery gateway that apply here.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /blogs/

# Refuse author scans and the REST user list.
RewriteCond %{QUERY_STRING} (author=\d+) [NC,OR]
RewriteCond %{REQUEST_URI} ^.*wp-json/wp/v2/users(?!/me) [NC]
RewriteRule .* - [F,L]

RewriteRule ^xmlrpc\.php$ - [F,L]

# Paths that are not files or folders here load WordPress.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /gallery/index.php [L]
</IfModule>

<Files xmlrpc.php>
  Require all denied
</Files>

<FilesMatch ^(?i:\.ht.*)$>
  Require all denied
</FilesMatch>

Options -Indexes
