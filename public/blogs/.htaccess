# Article listing of bas.org.in.
#
# /blogs/ and the other files in this folder are static pages. Articles
# are WordPress posts in the Articles category, with the address
# /blogs/<post name>/. This file has no rewrite rules, so the root
# .htaccess sends a path that is not a file here to WordPress
# (bas-site-ops docs/site-addresses.md, SA-5 and SA-8).

<Files xmlrpc.php>
  Require all denied
</Files>

<FilesMatch ^(?i:\.ht.*)$>
  Require all denied
</FilesMatch>

Options -Indexes
